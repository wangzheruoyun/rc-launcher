    <string name="tutorial_step_account_title">Add an account</string>
    <string name="tutorial_step_done_body">Onboarding complete. You can rewatch this tutorial anytime from &quot;Settings → Help&quot;, or reset it to start from the first step again.</string>
    <string name="tutorial_step_done_title">You are all set</string>
    <string name="tutorial_step_import_body">The &quot;Downloads&quot; tab imports CurseForge / Modrinth packs and local .zip modpacks. Skin import walkthrough is on the &quot;Accounts&quot; screen.</string>
    <string name="tutorial_step_import_title">Import modpacks &amp; skins</string>
    <string name="tutorial_step_instance_body">Use the &quot;Instances&quot; tab to install a new version or import a modpack. Forge, NeoForge, Fabric and Quilt are all supported.</string>
    <string name="tutorial_step_instance_title">Create an instance</string>
    <string name="tutorial_step_renderer_body">GL4ES is the default for the broadest compatibility. If you see visual glitches, switch to Zink / ANGLE / VirGL under &quot;Settings → Renderer&quot;.</string>
